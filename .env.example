# Gemini API Key - get yours at https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# NVIDIA NIM API Key (Used for DeepSeek V4 Flash, NV-EmbedCode, and NVIDIA's Gemma endpoint)
# Get yours at https://build.nvidia.com
VITE_NVIDIA_NIM_API_KEY=

# Gemma API Key (If using a separate provider for Gemma other than NVIDIA NIM)
VITE_GEMMA_API_KEY=
